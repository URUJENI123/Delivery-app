generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SENDER
  COURIER
  ADMIN
}

enum CourierVerificationTier {
  BASIC
  IDENTITY
  VEHICLE
  TRUSTED
}

enum DeliveryStatus {
  DRAFT
  BROADCAST
  COURIER_ASSIGNED
  COURIER_CONFIRMED
  PICKUP_EN_ROUTE
  ARRIVED_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED_DROPOFF
  DELIVERED
  CANCELLED
  DISPUTED
  FAILED
}

enum PackageCategory {
  DOCUMENT
  FOOD
  ELECTRONICS
  CLOTHING
  PHARMACY
  FRAGILE
  OTHER
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  PLATFORM_BALANCE
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_SENDER
  RESOLVED_COURIER
  CLOSED
}

enum EventType {
  DELIVERY_CREATED
  BROADCAST_SENT
  COURIER_INTERESTED
  COURIER_SELECTED
  COURIER_CONFIRMED
  COURIER_DEPARTED_PICKUP
  COURIER_ARRIVED_PICKUP
  PICKUP_OTP_SENT
  PICKUP_OTP_CONFIRMED
  PACKAGE_PICKED_UP
  PACKAGE_IN_TRANSIT
  LOCATION_UPDATE
  COURIER_ARRIVED_DROPOFF
  DROPOFF_OTP_SENT
  DROPOFF_OTP_CONFIRMED
  DELIVERY_COMPLETED
  DELIVERY_CANCELLED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  CHAT_MESSAGE_SENT
}

enum WalletTransactionType {
  credit
  debit
  fee
  withdrawal
  refund
}

enum WalletTransactionStatus {
  pending
  completed
  failed
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
}

enum RefundStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  DISBURSED
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?   @map("password_hash")
  fullName        String?   @map("full_name")
  role            UserRole  @default(SENDER)
  profilePhotoUrl String?   @map("profile_photo_url")
  emailVerified   Boolean   @default(false) @map("email_verified")
  phoneVerified   Boolean   @default(false) @map("phone_verified")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  courier           Courier?
  senderProfile     SenderProfile?
  onboardingSession OnboardingSession?
  deliveriesAsSender Delivery[]        @relation("SenderDeliveries")
  deliveryEvents    DeliveryEvent[]
  chatMessages      ChatMessage[]
  ratingsGiven      Rating[]           @relation("RatingsGiven")
  ratingsReceived   Rating[]           @relation("RatingsReceived")
  wallet            Wallet?
  refreshTokens     RefreshToken[]
  refundsRequested  RefundRequest[] @relation("RefundsRequested")
  refundsReviewed   RefundRequest[] @relation("RefundsReviewed")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SenderProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  businessName          String?  @map("business_name")
  businessType          String?  @map("business_type")
  defaultPickupAddress  String?  @map("default_pickup_address")
  preferredContactMethod String? @map("preferred_contact_method")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sender_profiles")
}

model OnboardingSession {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  currentStep          Int      @default(0) @map("current_step")
  totalSteps           Int      @default(4) @map("total_steps")
  isComplete           Boolean  @default(false) @map("is_complete")
  isSubmitted          Boolean  @default(false) @map("is_submitted")
  fullName             String?  @map("full_name")
  email                String?
  phone                String?
  nationalIdNumber     String?  @map("national_id_number")
  emergencyContactName String?  @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  motorcyclePlate      String?  @map("motorcycle_plate")
  associationCode      String?  @map("association_code")
  jacketSerialNumber   String?  @map("jacket_serial_number")
  operatingZone        String?  @map("operating_zone")
  momoNumber           String?  @map("momo_number")
  momoProvider         String?  @map("momo_provider")
  selfieUrl            String?  @map("selfie_url")
  idPhotoUrl           String?  @map("id_photo_url")
  vehiclePhotoFrontUrl String?  @map("vehicle_photo_front_url")
  vehiclePhotoRearUrl  String?  @map("vehicle_photo_rear_url")
  licensePhotoUrl      String?  @map("license_photo_url")
  jacketPhotoUrl       String?  @map("jacket_photo_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_sessions")
}

model Courier {
  id                   String                  @id @default(uuid())
  userId               String                  @unique @map("user_id")
  nationalIdNumber     String?                 @map("national_id_number")
  motorcyclePlate      String?                 @map("motorcycle_plate")
  associationCode      String?                 @map("association_code")
  jacketSerialNumber   String?                 @map("jacket_serial_number")
  operatingZone        String?                 @map("operating_zone")
  selfieUrl            String?                 @map("selfie_url")
  idPhotoUrl           String?                 @map("id_photo_url")
  vehiclePhotoFrontUrl String?                 @map("vehicle_photo_front_url")
  vehiclePhotoRearUrl  String?                 @map("vehicle_photo_rear_url")
  licensePhotoUrl      String?                 @map("license_photo_url")
  jacketPhotoUrl       String?                 @map("jacket_photo_url")
  verificationTier     CourierVerificationTier @default(BASIC) @map("verification_tier")
  isApprovedByAdmin    Boolean                 @default(false) @map("is_approved_by_admin")
  adminNotes           String?                 @map("admin_notes")
  isOnline             Boolean                 @default(false) @map("is_online")
  currentLat           Float?                  @map("current_lat")
  currentLng           Float?                  @map("current_lng")
  lastLocationAt       DateTime?               @map("last_location_at")
  totalDeliveries      Int                     @default(0) @map("total_deliveries")
  completionRate       Float                   @default(0) @map("completion_rate")
  avgRating            Float                   @default(0) @map("avg_rating")
  reliabilityScore     Float                   @default(100) @map("reliability_score")
  totalEarnings        Float                   @default(0) @map("total_earnings")
  emergencyContactName String?                 @map("emergency_contact_name")
  emergencyContactPhone String?                @map("emergency_contact_phone")
  momoNumber           String?                 @map("momo_number")
  momoProvider         String?                 @map("momo_provider")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries        Delivery[]         @relation("CourierDeliveries")
  courierLocations  CourierLocation[]
  courierInterests  CourierInterest[]

  @@map("couriers")
}

model CourierLocation {
  id         String   @id @default(uuid())
  courierId  String   @map("courier_id")
  deliveryId String?  @map("delivery_id")
  lat        Float
  lng        Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  recordedAt DateTime @default(now()) @map("recorded_at")

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, recordedAt])
  @@map("courier_locations")
}

model Delivery {
  id                     String         @id @default(uuid())
  trackingCode           String         @unique @default(uuid()) @map("tracking_code")
  senderId               String         @map("sender_id")
  courierId              String?        @map("courier_id")
  pickupAddress          String         @map("pickup_address")
  pickupLat              Float          @map("pickup_lat")
  pickupLng              Float          @map("pickup_lng")
  pickupNotes            String?        @map("pickup_notes")
  pickupEmail            String?        @map("pickup_email")
  dropoffAddress         String         @map("dropoff_address")
  dropoffLat             Float          @map("dropoff_lat")
  dropoffLng             Float          @map("dropoff_lng")
  dropoffNotes           String?        @map("dropoff_notes")
  dropoffEmail           String?        @map("dropoff_email")
  distanceKm             Float?         @map("distance_km")
  itemDescription        String         @map("item_description")
  category               PackageCategory @default(OTHER)
  size                   PackageSize    @default(SMALL)
  estimatedValueRwf      Float?         @map("estimated_value_rwf")
  isFragile              Boolean        @default(false) @map("is_fragile")
  requiresRecipientOtp   Boolean        @default(true) @map("requires_recipient_otp")
  pickupContactName      String         @map("pickup_contact_name")
  pickupContactPhone     String         @map("pickup_contact_phone")
  recipientName          String         @map("recipient_name")
  recipientPhone         String         @map("recipient_phone")
  scheduledPickupAt      DateTime?      @map("scheduled_pickup_at")
  preferAsap             Boolean        @default(true) @map("prefer_asap")
  quotedPriceRwf         Float?         @map("quoted_price_rwf")
  finalPriceRwf          Float?         @map("final_price_rwf")
  agreedPriceRwf         Float?         @map("agreed_price_rwf")
  agreedDeliveryTime     Int?           @map("agreed_delivery_time")
  paymentMethod          PaymentMethod  @default(CASH) @map("payment_method")
  paymentStatus          PaymentStatus  @default(PENDING) @map("payment_status")
  paymentHeldAt          DateTime?      @map("payment_held_at")
  paymentReleasedAt      DateTime?      @map("payment_released_at")
  pickupOtpHash          String?        @map("pickup_otp_hash")
  dropoffOtpHash         String?        @map("dropoff_otp_hash")
  otpVerifiedAt          DateTime?      @map("otp_verified_at")
  recipientTrackingToken String?        @unique @map("recipient_tracking_token")
  status                 DeliveryStatus @default(DRAFT)
  broadcastExpiresAt     DateTime?      @map("broadcast_expires_at")
  assignmentExpiresAt    DateTime?      @map("assignment_expires_at")
  deliveryStartedAt      DateTime?      @map("delivery_started_at")
  courierArrivedAt       DateTime?      @map("courier_arrived_at")
  dropoffOtpSentAt       DateTime?      @map("dropoff_otp_sent_at")
  pickupPhotoUrl         String?        @map("pickup_photo_url")
  dropoffPhotoUrl        String?        @map("dropoff_photo_url")
  recipientSignatureUrl  String?        @map("recipient_signature_url")
  pickedUpAt             DateTime?      @map("picked_up_at")
  deliveredAt            DateTime?      @map("delivered_at")
  cancelledAt            DateTime?      @map("cancelled_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  sender          User             @relation("SenderDeliveries", fields: [senderId], references: [id])
  courier         Courier?         @relation("CourierDeliveries", fields: [courierId], references: [id])
  events          DeliveryEvent[]
  chatMessages    ChatMessage[]
  courierInterests CourierInterest[]
  dispute         Dispute?
  rating          Rating?
  refundRequests  RefundRequest[]

  @@index([status])
  @@index([senderId])
  @@index([courierId])
  @@map("deliveries")
}

model CourierInterest {
  id               String   @id @default(uuid())
  deliveryId       String   @map("delivery_id")
  courierId        String   @map("courier_id")
  proposedPriceRwf Float?   @map("proposed_price_rwf")
  etaMinutes       Int?     @map("eta_minutes")
  expressedAt      DateTime @default(now()) @map("expressed_at")
  isSelected       Boolean  @default(false) @map("is_selected")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courier  Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, courierId])
  @@map("courier_interests")
}

model DeliveryEvent {
  id         String    @id @default(uuid())
  deliveryId String    @map("delivery_id")
  userId     String?   @map("user_id")
  eventType  EventType @map("event_type")
  metadata   Json?
  lat        Float?
  lng        Float?
  occurredAt DateTime  @default(now()) @map("occurred_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([deliveryId, occurredAt])
  @@map("delivery_events")
}

model ChatMessage {
  id         String    @id @default(uuid())
  deliveryId String    @map("delivery_id")
  senderId   String    @map("sender_id")
  body       String
  photoUrl   String?   @map("photo_url")
  isTemplate Boolean   @default(false) @map("is_template")
  readAt     DateTime? @map("read_at")
  sentAt     DateTime  @default(now()) @map("sent_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([deliveryId, sentAt])
  @@map("chat_messages")
}

model Rating {
  id         String   @id @default(uuid())
  deliveryId String   @unique @map("delivery_id")
  giverId    String   @map("giver_id")
  receiverId String   @map("receiver_id")
  stars      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  giver    User     @relation("RatingsGiven", fields: [giverId], references: [id])
  receiver User     @relation("RatingsReceived", fields: [receiverId], references: [id])

  @@map("ratings")
}

model Dispute {
  id           String        @id @default(uuid())
  deliveryId   String        @unique @map("delivery_id")
  raisedById   String        @map("raised_by_id")
  reason       String
  description  String?
  evidenceUrls String[]      @map("evidence_urls")
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String                  @map("wallet_id")
  type          WalletTransactionType
  description   String
  amount        Float
  referenceType String?                 @map("reference_type")
  referenceId   String?                 @map("reference_id")
  status        WalletTransactionStatus @default(completed)
  metadata      Json?
  createdAt     DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  walletId      String           @map("wallet_id")
  userId        String           @map("user_id")
  amount        Float
  method        String           @default("mobile_money")
  provider      String?
  accountNumber String?          @map("account_number")
  status        WithdrawalStatus @default(pending)
  reference     String?
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model RefundRequest {
  id            String       @id @default(uuid())
  deliveryId    String       @map("delivery_id")
  requestedById String       @map("requested_by_id")   // sender's userId
  amountRwf     Float        @map("amount_rwf")
  reason        String
  status        RefundStatus @default(PENDING_REVIEW)
  phoneNumber   String?      @map("phone_number")       // MoMo number for disbursement
  provider      String?                                 // MTN or AIRTEL
  adminNote     String?      @map("admin_note")
  reviewedById  String?      @map("reviewed_by_id")     // admin who approved/rejected
  reviewedAt    DateTime?    @map("reviewed_at")
  disbursedAt   DateTime?    @map("disbursed_at")
  transactionId String?      @map("transaction_id")     // MoMo txn ref
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("RefundsRequested", fields: [requestedById], references: [id])
  reviewedBy  User?    @relation("RefundsReviewed",  fields: [reviewedById],  references: [id])

  @@index([status])
  @@index([requestedById])
  @@map("refund_requests")
}
