# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get both strings from your Neon project dashboard → Connection Details
# DATABASE_URL uses the pooled connection (port 6543)
# DIRECT_URL uses the direct connection (port 5432) — required for Prisma migrations
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/neondb?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Cloudinary (file storage & uploads) ──────────────────────────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Africa's Talking (SMS / OTP) ─────────────────────────────────────────────
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_API_KEY=your-africastalking-api-key

# ─── MTN MoMo Rwanda ──────────────────────────────────────────────────────────
# Sign up at: https://momoapi.mtn.co.rw  (production Rwanda)
#             https://sandbox.momodeveloper.mtn.com  (sandbox testing)
#
# Create two products in the portal: Collections + Disbursements
# Each product has its own API User ID, API Key, and Subscription Key.
#
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CURRENCY=RWF
# -- Collections: used to charge the sender's MTN wallet (debit on top-up / pay for delivery)
MTN_COLLECTION_API_USER_ID=your-collection-api-user-id
MTN_COLLECTION_API_KEY=your-collection-api-key
MTN_COLLECTION_SUBSCRIPTION_KEY=your-collection-subscription-key
# -- Disbursements: used to pay out to the courier's MTN wallet (withdrawal)
MTN_DISBURSEMENT_API_USER_ID=your-disbursement-api-user-id
MTN_DISBURSEMENT_API_KEY=your-disbursement-api-key
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=your-disbursement-subscription-key
# For production Rwanda set:
# MTN_MOMO_BASE_URL=https://momoapi.mtn.co.rw
# MTN_MOMO_TARGET_ENV=mtnrwanda

# ─── Airtel Money Rwanda ───────────────────────────────────────────────────────
# Sign up at: https://developers.airtel.africa
# Create an application → add Collection-APIs and Remittance-APIs
#
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
# Merchant PIN required for Airtel disbursements (B2C payouts)
AIRTEL_MERCHANT_PIN=your-airtel-merchant-pin

# ─── Payment webhook ──────────────────────────────────────────────────────────
# Register this URL in the MTN and Airtel developer portals as the callback URL.
# POST /api/v1/wallet/webhook  — receives status updates for collections & disbursements
# In production, restrict this route to MTN/Airtel IP ranges at your reverse proxy.

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ─── Kigali Delivery Settings ─────────────────────────────────────────────────
# Service covers 3 districts of Kigali City: Nyarugenge · Kicukiro · Gasabo
#
# BROADCAST_RADIUS_KM: radius around a pickup point to search for online couriers.
#   Kigali is compact — 5 km covers most of a single district.
#   Increase to 8–10 km for cross-district jobs during off-peak hours.
BROADCAST_RADIUS_KM=5

# BROADCAST_WINDOW_SECONDS: how long a job stays in BROADCAST state before
#   it is marked FAILED if no courier takes it.
#   90 seconds is aggressive; increase to 300 for lower-demand times.
BROADCAST_WINDOW_SECONDS=90

# COURIER_CONFIRM_TIMEOUT_SECONDS: time a courier has to confirm after taking
#   a job before it is re-broadcast.
COURIER_CONFIRM_TIMEOUT_SECONDS=60

# OTP_EXPIRY_MINUTES: how long pickup / dropoff OTPs remain valid.
#   10 min is the minimum; 15 min accounts for typical Kigali traffic delays.
OTP_EXPIRY_MINUTES=15

# MIN_DELIVERY_PRICE_RWF: minimum agreed delivery price.
#   200 RWF is the floor for a short same-district trip.
MIN_DELIVERY_PRICE_RWF=200

# MAX_DELIVERY_TIME_MINUTES: maximum allowed agreedDeliveryTime.
#   120 min (2 hours) covers the longest cross-district trip in Kigali.
MAX_DELIVERY_TIME_MINUTES=120

# SERVICE_FEE_RWF: flat platform fee deducted from every courier payout.
SERVICE_FEE_RWF=100
